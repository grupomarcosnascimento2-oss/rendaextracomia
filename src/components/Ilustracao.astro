        ? `<rect x="${x}" y="${y}" width="16" height="16" rx="4" fill="rgba(255,255,255,.75)" stroke="none"/>`
        : `<rect x="${x}" y="${y}" width="16" height="16" rx="4" stroke-width="1.5" stroke-opacity=".6"/>`,
  )
  .join('');

