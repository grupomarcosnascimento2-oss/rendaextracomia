const C = 'rgba(255,255,255,.16)'; // superfície clara
const O = '#ffd84a'; // detalhe em amarelo
const N = '#061722'; // traço escuro sobre o amarelo

const janela = (x: number, y: number, w: number, h: number) => `
  <rect x="${x}" y="${y}" width="${w}" height="${h}" rx="10" fill="${E}"/>
  <path d="M${x} ${y + 22}h${w}" stroke-width="2"/>
  <g fill="#fff" stroke="none" opacity=".8"><circle cx="${x + 14}" cy="${y + 11}" r="3"/><circle cx="${x + 26}" cy="${y + 11}" r="3"/><circle cx="${x + 38}" cy="${y + 11}" r="3"/></g>`;

// 13: sete blocos, um para cada plataforma
const blocos = [16, 60, 104, 148]
  .map((x) => [x, 30])
  .concat([38, 82, 126].map((x) => [x, 82]))
  .map(([x, y], i) =>
    i === 5
      ? `<rect x="${x}" y="${y}" width="36" height="36" rx="9" fill="${O}" stroke="${O}"/><path d="M${x + 10} ${y + 19}l6 6 11-12" stroke="${N}" stroke-width="3.5"/>`
      : `<rect x="${x}" y="${y}" width="36" height="36" rx="9" fill="${E}"/><circle cx="${x + 12}" cy="${y + 13}" r="4" stroke-width="2"/><path d="M${x + 9} ${y + 26}h18" stroke-width="2" stroke-opacity=".75"/>`,
  )
  .join('');

// 19: calendário com os dias cumpridos e o dia da meta
const dias = [0, 1, 2]
  .flatMap((l) => [0, 1, 2, 3, 4].map((c) => [44 + c * 24, 66 + l * 24, l * 5 + c]))
  .map(([x, y, i]) =>
    i === 14
      ? `<rect x="${x}" y="${y}" width="16" height="16" rx="4" fill="${O}" stroke="${O}"/>`
