---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cartao from '../../components/Cartao.astro';
import Capa from '../../components/Capa.astro';
import Ilustracao from '../../components/Ilustracao.astro';
import Anuncio from '../../components/Anuncio.astro';
import { site, trilhaDe } from '../../config';
import { todosOsArtigos, linkDoArtigo, minutosDeLeitura, dataPorExtenso } from '../../lib/artigos';

export async function getStaticPaths() {
  const artigos = await todosOsArtigos();
  return artigos.map((artigo, i) => ({
    params: { slug: artigo.id },
    props: {
      artigo,
      total: artigos.length,
      ordem: i + 1,
      anterior: artigos[i - 1],
      proximo: artigos[i + 1],
      daTrilha: artigos.filter((a) => a.data.trilha === artigo.data.trilha),
    },
  }));
}

const { artigo, total, ordem, anterior, proximo, daTrilha } = Astro.props;
const { Content, headings } = await render(artigo);
const secoes = headings.filter((h) => h.depth === 2);
const { titulo, descricao, numero, faq, publicadoEm, atualizadoEm } = artigo.data;
const trilha = trilhaDe(artigo.data.trilha);
const endereco = new URL(linkDoArtigo(artigo), Astro.site).href;
const cores = `--cor:${trilha.cor};--cor-escura:${trilha.corEscura}`;
const outrosDaTrilha = daTrilha.filter((a) => a.id !== artigo.id);

const dados: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: titulo,
    description: descricao,
    inLanguage: 'pt-BR',
    datePublished: publicadoEm.toISOString(),
    dateModified: atualizadoEm.toISOString(),
    mainEntityOfPage: endereco,
    author: { '@type': 'Person', name: site.autor.nome },
    publisher: { '@type': 'Organization', name: site.nome },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: trilha.nome, item: new URL(`/trilhas/${trilha.slug}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: titulo, item: endereco },
    ],
  },
];
if (faq.length) {
  dados.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: f.resposta },
    })),
  });
}
---

<Base titulo={titulo} descricao={descricao} tipo="article" dadosEstruturados={dados}>
  <div class="progresso" id="progresso" style={cores} aria-hidden="true"></div>

  <article style={cores}>
    <header class="faixa">
      <Capa semente={numero} aneis={16} />
      <Ilustracao numero={numero} />
      <div class="envolve">
        <a class="migalha" href={`/trilhas/${trilha.slug}/`}><i></i>Trilha {trilha.numero}: {trilha.nome}</a>
        <h1>{titulo}</h1>
        <p class="lide">{descricao}</p>
        <ul class="dados">
          <li>Artigo {ordem} de {total}</li>
          <li>Leitura de {minutosDeLeitura(artigo)} minutos</li>
          <li>Atualizado em <time datetime={atualizadoEm.toISOString().slice(0, 10)}>{dataPorExtenso(atualizadoEm)}</time></li>
        </ul>
      </div>
    </header>

    <div class="envolve leitura">
      <div>
        <div class="prosa" id="texto">
          <Content />
        </div>

        <Anuncio />

        {
          faq.length > 0 && (
            <section class="faq" aria-labelledby="perguntas-frequentes">
              <h2 id="perguntas-frequentes">Perguntas frequentes</h2>
              {faq.map((f, i) => (
                <details open={i === 0}>
                  <summary>{f.pergunta}</summary>
                  <p>{f.resposta}</p>
                </details>
              ))}
            </section>
          )
        }

        <aside class="conferido">
          <p>
            Valores e plataformas conferidos em {site.conferidoEm}. Eles mudam com frequência, então confirme na página
            oficial de cada empresa antes de decidir.
          </p>
          <p>
            Nenhum ganho é garantido. Veja as <a href="/fontes/">fontes consultadas</a> e o{' '}
            <a href="/aviso-legal/">aviso legal</a>.
          </p>
        </aside>

        <div class="assinatura">
          <span class="assinatura-selo" aria-hidden="true">{site.autor.nome.charAt(0)}</span>
          <div>
            <p>Por <a href="/sobre/">{site.autor.nome}</a></p>
            <p class="bio">{site.autor.bio}</p>
          </div>
        </div>

        <nav class="vizinhos" aria-label="Artigo anterior e próximo">
          {
            anterior && (
              <a href={linkDoArtigo(anterior)} rel="prev">
                <small>Artigo anterior</small>
                <span>{anterior.data.titulo}</span>
              </a>
            )
          }
          {
            proximo && (
              <a href={linkDoArtigo(proximo)} rel="next">
                <small>Próximo artigo</small>
                <span>{proximo.data.titulo}</span>
              </a>
            )
          }
        </nav>
      </div>

      <nav class="sumario" aria-labelledby="sumario-titulo">
        <h2 id="sumario-titulo">Neste artigo</h2>
        <ol>
          {secoes.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          {faq.length > 0 && <li><a href="#perguntas-frequentes">Perguntas frequentes</a></li>}
        </ol>
      </nav>
    </div>
  </article>

  <section class="secao envolve" aria-labelledby="mesma-trilha">
    <div class="secao-cabeca">
      <h2 id="mesma-trilha">Continue nesta trilha</h2>
    </div>
    <div class="grade">
      {outrosDaTrilha.map((a) => <Cartao artigo={a} />)}
    </div>
  </section>
</Base>

<script>
  // Barra de progresso de leitura e destaque da seção atual no sumário
  const barra = document.getElementById('progresso')!;
  const texto = document.getElementById('texto')!;
  let pedido = 0;
  function medir() {
    const inicio = texto.offsetTop;
    const fim = inicio + texto.offsetHeight - window.innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, (window.scrollY - inicio + 200) / Math.max(1, fim - inicio + 200)));
    barra.style.transform = `scaleX(${p})`;
    pedido = 0;
  }
  window.addEventListener('scroll', () => { if (!pedido) pedido = requestAnimationFrame(medir); }, { passive: true });
  medir();

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sumario a'));
  const alvos = links
    .map((l) => document.getElementById(decodeURIComponent(l.hash.slice(1))))
    .filter((el): el is HTMLElement => !!el);
  if (alvos.length) {
    const marcar = () => {
      let atual = alvos[0];
      for (const el of alvos) if (el.getBoundingClientRect().top < 140) atual = el;
      links.forEach((l) => l.setAttribute('aria-current', String(decodeURIComponent(l.hash.slice(1)) === atual.id)));
    };
    window.addEventListener('scroll', marcar, { passive: true });
    marcar();
  }
</script>
