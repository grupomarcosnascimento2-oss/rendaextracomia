---
import Base from './Base.astro';
import Capa from '../components/Capa.astro';
interface Props {
  titulo: string;
  descricao: string;
  dadosEstruturados?: object[];
}
const { titulo, descricao, dadosEstruturados = [] } = Astro.props;
---

<Base titulo={titulo} descricao={descricao} dadosEstruturados={dadosEstruturados}>
  <header class="faixa">
    <Capa semente={200 + titulo.length} aneis={16} />
    <div class="envolve">
      <h1>{titulo}</h1>
    </div>
  </header>
  <div class="envolve pagina">
    <div class="prosa">
      <slot />
    </div>
  </div>
</Base>
