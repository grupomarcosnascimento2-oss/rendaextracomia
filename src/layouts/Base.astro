---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/literata';
import '../estilos/global.css';
import { site } from '../config';
import Consentimento from '../components/Consentimento.astro';

interface Props {
  titulo?: string;
  descricao?: string;
  tipo?: 'website' | 'article';
  dadosEstruturados?: object[];
}
const { titulo, descricao = site.descricao, tipo = 'website', dadosEstruturados = [] } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${site.nome}` : `${site.nome}: ${site.frase}`;
const canonico = new URL(Astro.url.pathname, Astro.site);
const pagina = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {site.adsense.cliente && <meta name="google-adsense-account" content={site.adsense.cliente} />}
    {
      site.adsense.cliente && (
        <script is:inline define:vars={{ cliente: site.adsense.cliente }}>
          // Google AdSense: o código só entra na página depois que o visitante aceita os cookies.
          window.carregarAnuncios = function () {
            if (document.getElementById('adsense')) return;
            var s = document.createElement('script');
            s.id = 'adsense';
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + cliente;
            document.head.appendChild(s);
            var blocos = document.querySelectorAll('ins.adsbygoogle:not([data-pedido])');
            for (var i = 0; i < blocos.length; i++) {
              blocos[i].setAttribute('data-pedido', '');
              blocos[i].closest('.anuncio').hidden = false;
              (window.adsbygoogle = window.adsbygoogle || []).push({});
            }
          };
          var aceito = false;
          try {
            aceito = localStorage.getItem('consentimento-cookies') === 'aceito';
          } catch (e) {}
          if (aceito) document.addEventListener('DOMContentLoaded', window.carregarAnuncios);
        </script>
      )
    }
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonico} />
    {!site.indexavel && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={titulo ?? site.nome} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonico} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#061722" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {dadosEstruturados.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <header class="topo">
      <div class="envolve">
        <a class="marca" href="/"><span class="marca-selo" aria-hidden="true"></span>{site.nome}</a>
        <nav class="menu" aria-label="Principal">
          <a href="/#trilhas">Trilhas</a>
          <a class="menu-largo" href="/#artigos">Artigos</a>
          <a href="/sobre/" aria-current={pagina === '/sobre/' ? 'page' : undefined}>Sobre</a>
          <a class="menu-destaque" href="/#conta">Fazer a conta</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="base">
      <div class="envolve">
        <div>
          <a class="marca" href="/"><span class="marca-selo" aria-hidden="true"></span>{site.nome}</a>
          <p>
            Este blog não promete ganhos. R$ 100 por dia é uma meta de planejamento, e os valores citados mudam com
            frequência. Trabalho de verdade paga você. Se alguém pedir dinheiro para liberar tarefas, é golpe.
          </p>
        </div>
        <nav aria-label="Rodapé">
          <a href="/sobre/">Sobre</a>
          <a href="/fontes/">Fontes</a>
          <a href="/aviso-legal/">Aviso legal</a>
          <a href="/privacidade/">Privacidade</a>
          {site.contato && <a href="/contato/">Contato</a>}
          {site.adsense.cliente && <button type="button" class="base-botao" data-abrir-cookies>Preferências de cookies</button>}
        </nav>
      </div>
    </footer>

    {site.adsense.cliente && <Consentimento />}

    <script>
      import '../scripts/capas.ts';
    </script>
  </body>
</html>
